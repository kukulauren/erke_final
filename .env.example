# Copy this file to .env and fill in the values marked REQUIRED for your
# deployment. Everything else already matches the production defaults in
# app/variables.py — leave as-is unless you know you need to change it.

# ── Paths & sources ──────────────────────────────────────────────
# REQUIRED: path to your trained YOLO weights
MODEL_PATH=best.pt
# REQUIRED: local video file (testing) or camera/RTSP URL (production)
# e.g. VIDEO_PATH=rtsp://user:pass@192.168.1.10:554/stream1
VIDEO_PATH=
# REQUIRED: where suspicious transaction clips are saved
# (Windows production example: E:\IGS_record)
OUTPUT_DIR=./IGS_record
# Annotated output for the offline testing.py harness
OUTPUT_PATH=output_result.mp4

# ── Detection ────────────────────────────────────────────────────
CONF_THRESHOLD=0.5
OVERLAP_THRESHOLD=0.3

# ── Analytics thresholds ─────────────────────────────────────────
CUSTOMER_DWELL_TIME=3.0
SCANNER_PHONE_DISTANCE=80
SCANNER_ITEM_DISTANCE=100
SCANNER_MOVEMENT_THRESHOLD=3
SCAN_COOLDOWN=1.5
PAYMENT_COMPLETE_TIME=1.0

# ── Staff / customer differentiation ─────────────────────────────
STAFF_REENTRY_THRESHOLD=4
REENTRY_WINDOW=600.0
REENTRY_MIN_SESSIONS=2
STAFF_CUMULATIVE_TIME=900.0
STAFF_TIME_MIN_SESSIONS=3
STAFF_CONFIDENCE_THRESHOLD=0.65
RECENT_BEHAVIOR_WINDOW=1800.0
CONFIDENCE_DECAY_RATE=0.98

# ── Tracking / pose / actions ─────────────────────────────────────
# TRACKER_CONFIG defaults to app/botsort_reid.yaml (BoT-SORT + ReID) —
# only set this if you have a custom tracker config.
# TRACKER_CONFIG=
POSE_ENABLED=true
POSE_MODEL_PATH=yolo11n-pose.pt
POSE_CONF=0.35
WRIST_KEYPOINT_CONF=0.3
WRIST_NEAR_DISTANCE=60
SCAN_MIN_DURATION=0.4
CASH_MIN_DURATION=0.3
ACTION_GAP_TOLERANCE=0.5

# ── Recording ──────────────────────────────────────────────────────
VIDEO_CODEC=h264
H264_CRF=23
H264_PRESET=veryfast

# ── Frame queue / logging ─────────────────────────────────────────
FRAME_QUEUE_SIZE=64
TRANSACTION_LOG_DIR=logs/transactions

# ── Disk retention (days; 0 disables) ──────────────────────────────
RETENTION_DAYS=30
LOG_RETENTION_DAYS=180

# ── Training data: keep every Nth clean clip (0 disables) ─────────
TRAINING_DATA_DIR=training_data
TRAINING_CLIP_EVERY_N=20

# ── Server FPS profile ─────────────────────────────────────────────
MONITORING_FPS=10
TRANSACTION_FPS=25
